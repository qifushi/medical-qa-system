# 复制为 .env 后按需修改
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# 本地大模型服务地址（Ollama 的 OpenAI 兼容接口）
LMSTUDIO_API_URL=http://127.0.0.1:11434/v1/chat/completions
LMSTUDIO_MODEL=qwen2.5vl:7b

# 上传文件保存目录（留空则使用项目根目录下的 media）
# MEDIA_ROOT=

# 扫描件 PDF 的 OCR 配置
OCR_ENABLED=True
OCR_MAX_PAGES=10
OCR_DPI=200
OCR_LANG=ch
OCR_MIN_TEXT=20
PADDLE_PDX_MODEL_SOURCE=modelscope
